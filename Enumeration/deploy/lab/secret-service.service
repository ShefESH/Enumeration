[Unit]
Description=SHEFESH{secret_service}
After=network.target

[Service]
EnvironmentFile=/etc/default/secret-service
ExecStart=/usr/bin/python3 /usr/local/lib/enumeration/secret-service.py
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
